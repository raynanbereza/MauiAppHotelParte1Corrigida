<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Tertiary}">


        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="15"
                             Spacing="20">

            <Label Text="Hospedagem Contratada"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource White}"
                   Margin="0,10,0,10" />

            <Frame Padding="20" 
                   Margin="5" 
                   BackgroundColor="White" 
                   CornerRadius="12" 
                   HasShadow="True">

                <VerticalStackLayout Spacing="15" HorizontalOptions="FillAndExpand">

                    <Label Text="CONFIRMAÇÃO DE CHECK-IN"
                           TextTransform="Uppercase"
                           FontSize="Caption"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Tertiary}"
                           CharacterSpacing="1" />

                    <Label Text="Sua entrada está programada para a seguinte data:" 
                           FontSize="Small" 
                           TextColor="Gray" 
                           HorizontalTextAlignment="Center" />

                    <Label Text="20 de Maio de 2026" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="#2C3E50" />

                    <Label Text="Por favor, confirme os dados acima para validar a sua estadia no hotel." 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalTextAlignment="Center" 
                           Margin="10,0,10,5" />

                    <Button Text="Confirmar" 

                            BackgroundColor="{StaticResource Tertiary}"
                            TextColor="{StaticResource White}"
                            HeightRequest="45"
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar ao Painel" 
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource White}"
                    BorderColor="{StaticResource White}"
                    BorderWidth="1"
                    Margin="5,10,5,0" />

        </VerticalStackLayout>

</ContentPage>