<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Tertiary}">

    <VerticalStackLayout VerticalOptions="Center"
                         Padding="15"
                         Spacing="20">

        <Label Text="Hospedagem Contratada"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="{StaticResource White}"
               Margin="0,10,0,10" />

        <Frame Padding="20" 
               Margin="5" 
               BackgroundColor="White" 
               CornerRadius="12" 
               HasShadow="True">

            <VerticalStackLayout Spacing="15" HorizontalOptions="FillAndExpand">

                <Label Text="RESUMO DA HOSPEDAGEM"
                       TextTransform="Uppercase"
                       FontSize="Caption"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Tertiary}"
                       CharacterSpacing="1" />

                <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,5" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="Acomodação Selecionada:" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding QuartoSelecionado.Descricao}" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Check-in:" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#2C3E50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Check-out:" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#2C3E50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="Hóspedes:" FontSize="12" TextColor="Gray" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding QtdAdultos, StringFormat='{0} Adt'}" FontAttributes="Bold" TextColor="#2C3E50"/>
                            <Label Text="|" TextColor="LightGray"/>
                            <Label Text="{Binding QtdCriancas, StringFormat='{0} Crl'}" FontAttributes="Bold" TextColor="#2C3E50"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Total de Diárias:" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Estadia, StringFormat='{0} diária(s)'}" FontAttributes="Bold" TextColor="#2C3E50" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,5" />

                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="VALOR TOTAL DA ESTADIA" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" FontSize="28" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button Text="Confirmar Reserva" 
                        Clicked="OnConfirmarClicked"
                        BackgroundColor="{StaticResource Tertiary}"
                        TextColor="{StaticResource White}"
                        HeightRequest="45"
                        CornerRadius="8" 
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar ao Painel" 
                Clicked="OnVoltarClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource White}"
                BorderColor="{StaticResource White}"
                BorderWidth="1"
                Margin="5,10,5,0" />

    </VerticalStackLayout>
</ContentPage>